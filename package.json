{
  "name": "crazyland-motion",
  "version": "1.6.2",
  "description": "Crazyland Motion \u2014 a local-first Windows video editor",
  "main": "electron/main.cjs",
  "author": "Crazyland",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win portable --x64",
    "test:desktop": "node scripts/verify-desktop.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.crazyland.cutline",
    "productName": "Crazyland Motion",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "src/assets/icon.ico"
    },
    "portable": {
      "artifactName": "Crazyland-Motion-${version}.exe"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wobblingbottom/video-editing-tool.git"
  }
}
